<?xml version="1.0" encoding="UTF-8"?>
<!--
    correlationId is set per record (the producer's x-correlation-id, else the eventId) by the
    tracing:with-correlation-id scope; truckId is added with tracing:set-logging-variable.
-->
<Configuration>
    <Appenders>
        <RollingFile name="file"
                     fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}fleet-events-kafka.log"
                     filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}fleet-events-kafka-%i.log">
            <PatternLayout pattern="%d{ISO8601} %-5p [%t] [correlationId=%X{correlationId}] [truckId=%X{truckId}] %c - %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <AsyncLogger name="au.chipomho.fleet" level="INFO"/>
        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="INFO"/>
        <AsyncLogger name="org.apache.kafka" level="WARN"/>
        <AsyncLogger name="com.mulesoft.connectors.kafka" level="WARN"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="file"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
