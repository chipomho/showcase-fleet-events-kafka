<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:kafka="http://www.mulesoft.org/schema/mule/kafka"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:tracing="http://www.mulesoft.org/schema/mule/tracing"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/kafka http://www.mulesoft.org/schema/mule/kafka/current/mule-kafka.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/tracing http://www.mulesoft.org/schema/mule/tracing/current/mule-tracing.xsd">

    <!--
        Offsets are committed by hand, and only once a record has been dealt with: published to
        alerts or metrics, skipped as a duplicate, or parked on the dead-letter topic. An error
        that propagates leaves the offset uncommitted, so the record is consumed again; the
        redelivery policy caps that, after which MULE:REDELIVERY_EXHAUSTED sends it to the DLQ.
    -->
    <flow name="telemetry-consumer">
        <kafka:message-listener doc:name="fleet.telemetry" config-ref="kafka-consumer-config"
                                ackMode="MANUAL"
                                pollTimeout="${kafka.consumer.pollTimeoutMs}"
                                pollTimeoutTimeUnit="MILLISECONDS"
                                parallelConsumersAmount="${kafka.consumer.parallelConsumers}">
            <redelivery-policy maxRedeliveryCount="${kafka.consumer.maxRedeliveries}"
                               idExpression="#[attributes.topic ++ '/' ++ (attributes.partition as String) ++ '/' ++ (attributes.offset as String)]"/>
        </kafka:message-listener>

        <set-variable doc:name="Keep raw record for the DLQ" variableName="rawEvent" value="#[payload]"/>
        <ee:transform doc:name="Record context">
            <ee:variables>
                <ee:set-variable variableName="record" resource="dw/mappings/record-context.dwl"/>
            </ee:variables>
        </ee:transform>

        <tracing:with-correlation-id doc:name="Correlate on the producer's id" correlationId="#[vars.record.correlationId]">
            <flow-ref doc:name="Process event" name="process-telemetry-event"/>
        </tracing:with-correlation-id>

        <flow-ref doc:name="Commit offset" name="commit-offset"/>
        <error-handler ref="telemetry-error-handler"/>
    </flow>

    <!-- Parse, validate, de-duplicate on eventId, enrich, route. -->
    <flow name="process-telemetry-event">
        <flow-ref doc:name="Parse and validate" name="parse-and-validate-telemetry"/>
        <tracing:set-logging-variable doc:name="truckId in every log line" variableName="truckId" value="#[payload.truckId]"/>

        <flow-ref doc:name="Already published?" name="is-event-published" target="alreadyPublished"/>
        <choice doc:name="Duplicate?">
            <when expression="#[vars.alreadyPublished]">
                <logger doc:name="Skip duplicate" level="INFO" category="au.chipomho.fleet.telemetry"
                        message="#[output application/json indent=false --- { event: 'telemetry.duplicate_skipped', eventId: payload.eventId }]"/>
            </when>
            <otherwise>
                <ee:transform doc:name="Enrich">
                    <ee:message>
                        <ee:set-payload resource="dw/mappings/enrich-telemetry.dwl"/>
                    </ee:message>
                </ee:transform>
                <flow-ref doc:name="Route" name="route-telemetry"/>
                <!--
                    Recorded only after a successful publish. If the publish fails the record is
                    redelivered and must not look like a duplicate when it comes back.
                -->
                <flow-ref doc:name="Remember eventId" name="remember-published-event"/>
            </otherwise>
        </choice>
    </flow>

</mule>
